            "type": "integer",
            "minimum": 1
          },
          "max_chars": {
            "type": "integer",
            "minimum": 1
          },
          "view": {
            "type": "string",
            "enum": [
              "text",
              "parts",
              "part"
            ]
          },
          "part_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "member": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "Exact member name from the Word parts manifest. No aliases or path normalization. Used only with view=part. If part_id is also supplied, both must identify the same part."
          }
        },
        "additionalProperties": false,
        "anyOf": [
