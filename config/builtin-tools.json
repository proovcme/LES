    {
      "name": "read_source",
      "version": "1.2.0",
      "title": "Read indexed source",
      "category": "source",
      "summary": "Read indexed sections or preserved Word media. view=text reads chunks. view=parts lists originals/previews with a cursor. To read a specific DOCX picture or attachment, use view=part and its exact member name (for example word/media/image7.emf); prefer member to copying a hash. Optional part_id must belong to the same member. The result only describes that exact member, never a differently named picture. Empty OCR is unread content. Media navigation does not prove image details.",
      "input_schema": {
        "type": "object",
        "properties": {
          "doc_id": {
            "type": "string"
          },
          "dataset_id": {
            "type": "string"
          },
