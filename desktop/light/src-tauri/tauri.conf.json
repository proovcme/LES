{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LES RAG",
  "version": "0.1.0",
  "identifier": "me.ovc.les-light",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LES RAG",
        "width": 1280,
        "height": 860,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/les.ico"
    ]
  }
}
